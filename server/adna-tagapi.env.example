# Tagger backend secrets — TEMPLATE ONLY. Do NOT put the real password in the repo.
#
# Copy this to /home/ubuntu/adna-tagger.env (outside the repo) and set your own:
#   cp server/adna-tagapi.env.example /home/ubuntu/adna-tagger.env
#   chmod 600 /home/ubuntu/adna-tagger.env
#   # edit TAG_PW, then:
#   sudo systemctl restart adna-tagapi
# The systemd unit reads it via EnvironmentFile.
TAG_PW=changeme
